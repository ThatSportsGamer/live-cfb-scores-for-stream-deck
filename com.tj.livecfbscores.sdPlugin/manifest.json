{
    "Author": "T.J. Lauerman aka ThatSportsGamer",
    "CodePath": "plugin.js",
    "Description": "Shows live college football scores on your Stream Deck. Track one FBS team per key, or lay out the week's Top 25, a conference, or all of FBS with the Scoreboard action — score, quarter, clock, possession and rankings at a glance.",
    "Name": "Live CFB Scores",
    "UUID": "com.tj.livecfbscores",
    "Category": "Live Sports Scores",
    "URL": "https://github.com/ThatSportsGamer/live-cfb-scores-for-stream-deck",
    "Icon": "imgs/plugin-icon",
    "CategoryIcon": "imgs/category-icon",
    "Version": "1.1.1.0",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "6.9"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "10.15"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "20",
        "Debug": "disabled"
    },
    "Actions": [
        {
            "Name": "Live CFB Scores",
            "UUID": "com.tj.livecfbscores.score",
            "Icon": "imgs/action-icon",
            "Tooltip": "Shows live score for your chosen FBS college football team. Updates every 30 seconds.",
            "PropertyInspectorPath": "property-inspector.html",
            "States": [
                {
                    "Image": "imgs/action-icon",
                    "Title": ""
                }
            ],
            "SupportedInMultiActions": false
        },
        {
            "Name": "Live CFB Scoreboard",
            "UUID": "com.tj.livecfbscores.scoreboard",
            "Icon": "imgs/scoreboard-icon",
            "Tooltip": "Fills your keys with this week's college football games — the Top 25, a conference, or all of FBS — one game per key.",
            "PropertyInspectorPath": "scoreboard-inspector.html",
            "States": [
                {
                    "Image": "imgs/scoreboard-icon",
                    "Title": ""
                }
            ],
            "SupportedInMultiActions": false
        }
    ]
}